{
  "manifest_version": 3,
  "name": "ChatFree",
  "version": "0.1.0",
  "description": "Unified chat interface for DeepSeek and ChatGPT",
  "permissions": ["cookies", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "ChatFree",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content_chatgpt.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
