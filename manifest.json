{
  "manifest_version": 3,
  "name": "ChatFree",
  "version": "0.2.0",
  "description": "Unified chat interface for DeepSeek and ChatGPT",
  "permissions": ["cookies", "storage", "scripting", "tabs", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://www.doubao.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_strip_headers",
        "enabled": true,
        "path": "rules_headers.json"
      }
    ]
  },
  "action": {
    "default_title": "ChatFree",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["modules/site-deepseek.js", "modules/content-core.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content_chatgpt.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.doubao.com/*"],
      "js": ["modules/site-doubao.js", "modules/content-core.js", "content_doubao.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
